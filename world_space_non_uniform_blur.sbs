tSize"/><value v="11x11"/></option></options><root><rootOutputs><rootOutput><output v="1700000021"/><format v="0"/><usertag v=""/></rootOutput></rootOutputs></root></graph><graph><identifier v="world_space_non_uniform_blur_grayscale"/><uid v="1700040773"/><graphtype v="filter"/><attributes><label v="World Space Non Uniform Blur Grayscale"/><author v="Doru Bogdan"/><authorURL v="https://www.artstation.com/sublime"/><tags v="filter;blur;non uniform;bokeh;world space"/><description v="Grayscale version of World Space Non Uniform Blur (for masks)."/><icon><datalength v="7308"/><format v="png"/><strdata v=""/></icon></attributes><paraminputs><paraminput><identifier v="input"/><uid v="1700040774"/><attributes><label v="Input"/></attributes><isConnectable v="1"/><type v="2"/><defaultValue><constantValueFloat1 v="0"/></defaultValue><defaultWidget><name v=""/><options/></defaultWidget></paraminput><paraminput><identifier v="blur_map"/><uid v="1700040775"/><attributes><label v="Blur Map"/><description v="Grayscale map that scales the blur: white = full Intensity, black = no blur. Used when &quot;Use Blur Map&quot; is on and &quot;Use Input As Blur Map&quot; is off."/></attributes><isConnectable v="1"/><type v="2"/><defaultValue><constantValueFloat1 v="0"/></defaultValue><defaultWidget><name v=""/><options/></defaultWidget></paraminput><paraminput><identifier v="mesh_position"/><uid v="1700040776"/><attributes><label v="Mesh Position"/></attributes><isConnectable v="1"/><type v="1"/><defaultValue><constantValueFloat4 v="0 0 0 0"/></defaultValue><defaultWidget><name v=""/><options/></defaultWidget></paraminput><paraminput><identifier v="mesh_uv_mask"/><uid v="1700040777"/><attributes><label v="Mesh UV Mask"/></attributes><isConnectable v="1"/><type v="2"/><defaultValue><constantValueFloat1 v="0"/></defaultValue><defaultWidget><name v=""/><options/></defaultWidget></paraminput><paraminput><identifier v="samples"/><uid v="1700040778"/><attributes><label v="Samples"/><description v="Number of blur passes. More passes fill the bokeh shape more smoothly (and cost more)."/></attributes><type v="16"/><defaultValue><constantValueInt1 v="4"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="4"/></option><option><name v="max"/><value v="16"/></option><option><name v="min"/><value v="1"/></option><option><name v="step"/><value v="1"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="intensity"/><uid v="1700040779"/><attributes><label v="Intensity"/><description v="Blur radius, in the same units as the 2D Non-Uniform Blur (1 = 1/256 of the UV space), converted to world space with the average texel density of the mesh."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="10"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="10"/></option><option><name v="max"/><value v="50"/></option><option><name v="min"/><value v="0"/></option><option><name v="step"/><value v="0.01"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="anisotropy"/><uid v="1700040780"/><attributes><label v="Anisotropy"/><description v="Squashes the blur shape across the Angle direction (1 = a line)."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="0"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="0"/></option><option><name v="max"/><value v="1"/></option><option><name v="min"/><value v="0"/></option><option><name v="step"/><value v="0.01"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="blades"/><uid v="1700040781"/><attributes><label v="Blades"/><description v="Number of sides of the bokeh shape."/></attributes><type v="16"/><defaultValue><constantVa