<?xml version="1.0" encoding="UTF-8"?><package><identifier v="world_space_non_uniform_blur_lite"/><formatVersion v="1.1.0.202302"/><updaterVersion v="1.1.0.202302"/><fileUID v="{8d1e5c3a-27b4-4f96-a0c1-3e9b7d52f418}"/><versionUID v="0"/><dependencies><dependency><filename v="?himself"/><uid v="1500000001"/><type v="package"/><fileUID v="0"/><versionUID v="0"/></dependency></dependencies><content><graph><identifier v="world_space_non_uniform_blur_lite"/><uid v="1500037612"/><graphtype v="filter"/><attributes><label v="World Space Non Uniform Blur Lite"/><author v="Doru Bogdan"/><authorURL v="https://www.artstation.com/sublime"/><tags v="filter;blur;non uniform;bokeh;world space;lite"/><description v="v1.0 (Lite) - a cheaper World Space Non Uniform Blur: the same bokeh blur, continuous across UV seams, done on 6 axis views of each piece instead of voxels. Faces hidden from every view by another part of the same piece (e.g. the inner faces of a door frame, between stacked parts) are not blurred; use World Space Non Uniform Blur for those meshes."/><icon><datalength v="12102"/><format v="png"/><strdata v=""/></icon></attributes><paraminputs><paraminput><identifier v="input"/><uid v="1500000002"/><attributes><label v="Input"/></attributes><isConnectable v="1"/><type v="1"/><defaultValue><constantValueFloat4 v="0 0 0 0"/></defaultValue><defaultWidget><name v=""/><options/></defaultWidget></paraminput><paraminput><identifier v="blur_map"/><uid v="1500000005"/><attributes><label v="Blur Map"/><description v="Grayscale map that scales the blur: white = full Intensity, black = no blur. Used when &quot;Use Blur Map&quot; is on and &quot;Use Input As Blur Map&quot; is off."/></attributes><isConnectable v="1"/><type v="2"/><defaultValue><constantValueFloat1 v="0"/></defaultValue><defaultWidget><name v=""/><options/></defaultWidget></paraminput><paraminput><identifier v="mesh_position"/><uid v="1500000008"/><attributes><label v="Mesh Position"/></attributes><isConnectable v="1"/><type v="1"/><defaultValue><constantValueFloat4 v="0 0 0 0"/></defaultValue><defaultWidget><name v=""/><options/></defaultWidget></paraminput><paraminput><identifier v="mesh_uv_mask"/><uid v="1500000011"/><attributes><label v="Mesh UV Mask"/></attributes><isConnectable v="1"/><type v="2"/><defaultValue><constantValueFloat1 v="0"/></defaultValue><defaultWidget><name v=""/><options/></defaultWidget></paraminput><paraminput><identifier v="samples"/><uid v="1500000014"/><attributes><label v="Samples"/><description v="Number of blur passes. More passes fill the bokeh shape more smoothly (and cost more)."/></attributes><type v="16"/><defaultValue><constantValueInt1 v="4"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="4"/></option><option><name v="max"/><value v="16"/></option><option><name v="min"/><value v="1"/></option><option><name v="step"/><value v="1"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="intensity"/><uid v="1500000015"/><attributes><label v="Intensity"/><description v="Blur radius, in the same units as the 2D Non-Uniform Blur (1 = 1/256 of the UV space), at the mesh's average texel density."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="10"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="10"/></option><option><name v="max"/><value v="50"/></option><option><name v="min"/><value v="0"/></option><option><name v="step"/><value v="0.01"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="anisotropy"/><uid v="1500000016"/><attributes><label v="Anisotropy"/><description v="Squashes the blur shape across the Angle direction (1 = a line)."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="0"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="0"/></option><option><name v="max"/><value v="1"/></option><option><name v="min"/><value v="0"/></option><option><name v="step"/><value v="0.01"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="blades"/><uid v="1500000017"/><attributes><label v="Blades"/><description v="Number of sides of the bokeh shape."/></attributes><type v="16"/><defaultValue><constantValueInt1 v="5"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="5"/></option><option><name v="max"/><value v="9"/></option><option><name v="min"/><value v="1"/></option><option><name v="step"/><value v="1"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="angle"/><uid v="1500000018"/><attributes><label v="Angle"/><description v="Rotation of the blur shape around the surface normal, measured from the Reference Axis."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="0"/></defaultValue><defaultWidget><name v="angle"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="0"/></option><option><name v="max"/><value v="1"/></option><option><name v="min"/><value v="0"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="use_blur_map"/><uid v="1500000019"/><attributes><label v="Use Blur Map"/><description v="Scale the blur per texel (off = uniform blur)."/></attributes><type v="4"/><defaultValue><constantValueBool v="1"/></defaultValue><defaultWidget><name v="buttons"/><options><option><name v="default"/><value v="1"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="blur_map_from_input"/><uid v="1500000020"/><attributes><label v="Use Input As Blur Map"/><description v="Use the luminance of the Input itself as the blur map, so no extra texture is needed."/></attributes><type v="4"/><defaultValue><constantValueBool v="1"/></defaultValue><defaultWidget><name v="buttons"/><options><option><name v="default"/><value v="1"/></option></options></defaultWidget><group v="Blur"/><visibleIf v="input[&quot;use_blur_map&quot;]"/></paraminput><paraminput><identifier v="invert_blur_map"/><uid v="1500000021"/><attributes><label v="Invert Blur Map"/><description v="Blur the dark areas instead of the bright ones."/></attributes><type v="4"/><defaultValue><constantValueBool v="0"/></defaultValue><defaultWidget><name v="buttons"/><options><option><name v="default"/><value v="0"/></option></options></defaultWidget><group v="Blur"/><visibleIf v="input[&quot;use_blur_map&quot;]"/></paraminput><paraminput><identifier v="quality"/><uid v="1500000022"/><attributes><label v="Quality"/><description v="View resolution, shared by all pieces (1 = 1/8, 2 = 1/4, 3 = 1/2, 4 = all of a 2048 x 2048 budget). Higher keeps finer detail at low Intensity; lower is faster when the mesh changes."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="4"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="4"/></option><option><name v="max"/><value v="4"/></option><option><name v="min"/><value v="1"/></option><option><name v="step"/><value v="1"/></option></options></defaultWidget><group v="World Space"/></paraminput><paraminput><identifier v="axis_x"/><uid v="1500000023"/><attributes><label v="Reference Axis X"/><description v="Object-space direction that Angle 0 points to (projected on the surface)."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="0.0"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="0.0"/></option><option><name v="max"/><value v="1"/></option><option><name v="min"/><value v="-1"/></option><option><name 