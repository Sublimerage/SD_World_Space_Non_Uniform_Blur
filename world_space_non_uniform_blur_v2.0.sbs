<?xml version="1.0" encoding="UTF-8"?><package><identifier v="world_space_non_uniform_blur"/><formatVersion v="1.1.0.202302"/><updaterVersion v="1.1.0.202302"/><fileUID v="{4f6b2a1e-93c7-4d0a-b8e5-7c2d91a3f604}"/><versionUID v="0"/><dependencies><dependency><filename v="?himself"/><uid v="1500000001"/><type v="package"/><fileUID v="0"/><versionUID v="0"/></dependency></dependencies><content><graph><identifier v="world_space_non_uniform_blur"/><uid v="1500066570"/><graphtype v="filter"/><attributes><label v="World Space Non Uniform Blur"/><author v="Doru Bogdan"/><authorURL v="https://www.artstation.com/sublime"/><tags v="filter;blur;non uniform;bokeh;world space"/><description v="v2.0 - Non-uniform (bokeh) blur done in 3D using the mesh position, so it is continuous across UV seams. The Blur Map (or the input itself) scales the blur per texel like the 2D Non-Uniform Blur. Pieces laid out apart get their own voxel grids, so spreading them out doesn't coarsen the blur, and they don't blur into each other."/><icon><datalength v="12102"/><format v="png"/><strdata v=""/></icon></attributes><paraminputs><paraminput><identifier v="input"/><uid v="1500000002"/><attributes><label v="Input"/></attributes><isConnectable v="1"/><type v="1"/><defaultValue><constantValueFloat4 v="0 0 0 0"/></defaultValue><defaultWidget><name v=""/><options/></defaultWidget></paraminput><paraminput><identifier v="blur_map"/><uid v="1500000005"/><attributes><label v="Blur Map"/><description v="Grayscale map that scales the blur: white = full Intensity, black = no blur. Used when &quot;Use Blur Map&quot; is on and &quot;Use Input As Blur Map&quot; is off."/></attributes><isConnectable v="1"/><type v="2"/><defaultValue><constantValueFloat1 v="0"/></defaultValue><defaultWidget><name v=""/><options/></defaultWidget></paraminput><paraminput><identifier v="mesh_position"/><uid v="1500000008"/><attributes><label v="Mesh Position"/></attributes><isConnectable v="1"/><type v="1"/><defaultValue><constantValueFloat4 v="0 0 0 0"/></defaultValue><defaultWidget><name v=""/><options/></defaultWidget></paraminput><paraminput><identifier v="mesh_uv_mask"/><uid v="1500000011"/><attributes><label v="Mesh UV Mask"/></attributes><isConnectable v="1"/><type v="2"/><defaultValue><constantValueFloat1 v="0"/></defaultValue><defaultWidget><name v=""/><options/></defaultWidget></paraminput><paraminput><identifier v="samples"/><uid v="1500000014"/><attributes><label v="Samples"/><description v="Number of blur passes. More passes fill the bokeh shape more smoothly (and cost more)."/></attributes><type v="16"/><defaultValue><constantValueInt1 v="4"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="4"/></option><option><name v="max"/><value v="16"/></option><option><name v="min"/><value v="1"/></option><option><name v="step"/><value v="1"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="intensity"/><uid v="1500000015"/><attributes><label v="Intensity"/><description v="Blur radius, in the same units as the 2D Non-Uniform Blur (1 = 1/256 of the UV space), at the mesh's average texel density. Doesn't depend on how far apart the pieces are."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="10"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="10"/></option><option><name v="max"/><value v="50"/></option><option><name v="min"/><value v="0"/></option><option><name v="step"/><value v="0.01"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="anisotropy"/><uid v="1500000016"/><attributes><label v="Anisotropy"/><description v="Squashes the blur shape across the Angle direction (1 = a line)."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="0"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="0"/></option><option><name v="max"/><value v="1"/></option><option><name v="min"/><value v="0"/></option><option><name v="step"/><value v="0.01"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="blades"/><uid v="1500000017"/><attributes><label v="Blades"/><description v="Number of sides of the bokeh shape."/></attributes><type v="16"/><defaultValue><constantValueInt1 v="5"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="5"/></option><option><name v="max"/><value v="9"/></option><option><name v="min"/><value v="1"/></option><option><name v="step"/><value v="1"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="angle"/><uid v="1500000018"/><attributes><label v="Angle"/><description v="Rotation of the blur shape around the surface normal, measured from the Reference Axis."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="0"/></defaultValue><defaultWidget><name v="angle"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="0"/></option><option><name v="max"/><value v="1"/></option><option><name v="min"/><value v="0"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="use_blur_map"/><uid v="1500000019"/><attributes><label v="Use Blur Map"/><description v="Scale the blur per texel (off = uniform blur)."/></attributes><type v="4"/><defaultValue><constantValueBool v="1"/></defaultValue><defaultWidget><name v="buttons"/><options><option><name v="default"/><value v="1"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="blur_map_from_input"/><uid v="1500000020"/><attributes><label v="Use Input As Blur Map"/><description v="Use the luminance of the Input itself as the blur map, so no extra texture is needed."/></attributes><type v="4"/><defaultValue><constantValueBool v="1"/></defaultValue><defaultWidget><name v="buttons"/><options><option><name v="default"/><value v="1"/></option></options></defaultWidget><group v="Blur"/><visibleIf v="input[&quot;use_blur_map&quot;]"/></paraminput><paraminput><identifier v="invert_blur_map"/><uid v="1500000021"/><attributes><label v="Invert Blur Map"/><description v="Blur the dark areas instead of the bright ones."/></attributes><type v="4"/><defaultValue><constantValueBool v="0"/></defaultValue><defaultWidget><name v="buttons"/><options><option><name v="default"/><value v="0"/></option></options></defaultWidget><group v="Blur"/><visibleIf v="input[&quot;use_blur_map&quot;]"/></paraminput><paraminput><identifier v="softness"/><uid v="1500000022"/><attributes><label v="Softness"/><description v="Blurs each tap of the bokeh. Higher values are smoother and wrap better around hard edges and curved areas; 0 keeps the sharpest bokeh shape."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="0.25"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="0.25"/></option><option><name v="max"/><value v="1"/></option><option><name v="min"/><value v="0"/></option><option><name v="step"/><value v="0.01"/></option></options></defaultWidget><group v="World Space"/></paraminput><paraminput><identifier v="quality"/><uid v="1500000023"/><attributes><label v="Quality"/><description v="Voxel budget, shared by all pieces (1 = 48^3, 2 = 64^3, 3 = 96^3, 4 = 128^3 voxels). Higher keeps finer detail at low Intensity and is slower."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="4"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="4"/></option><option><name v="max"/><value v="4"/></option><option><name v="min"/><value v="1"/></option><option><name v="step"/><value v="1"/></option></options></defaultWidget><group v="World Space"/></paraminput><paraminput><identifier v="axis_x"/><uid v="1500000024"/><attributes><label v="Reference Axis X"/><description v="Object-space direction that Angle 0 points to (projected on the surface)."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="0.0"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="0.0"/></option><option><name v="max"/><value v="1"/></option><option><name v="min"/><value v="-1"/></option><option><name v="step"/><value v="0.05"/></option></options></defaultWidget><group v="World Space"/></paraminput><paraminput><identifier v="axis_y"/><uid v="1500000025"/><attributes><label v="Reference Axis Y"/><description v="Object-space direction that Angle 0 points to (projected on the surface)."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="1.0"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="1.0"/></option><option><name v="max"/><value v="1"/></option><option><name v="min"/><value v="-1"/></option><option><name v="step"/><value v="0.05"/></option></options></defaultWidget><group v="World Space"/></paraminput><paraminput><identifier v="axis_z"/><uid v="1500000026"/><attributes><label v="Reference Axis Z"/><description v="Object-space direction that Angle 0 points to (projected on the surface)."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="0.0"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="0.0"/></option><option><name v="max"/><value v="1"/></option><option><name v="min"/><value v="-1"/></option><option><name v="step"/><value v="0.05"/></option></options></defaultWidget><group v="World Space"/></paraminput><paraminput><identifier v="dither"/><uid v="1500000027"/><attributes><label v="Dither"/><description v="Fine noise (in 8-bit steps) that hides banding in smooth gradients. 0 = off."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="1.0"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="1.0"/></option><option><name v="max"/><value v="2"/></option><option><name v="min"/><value v="0"/></option><option><name v="step"/><value v="0.05"/></option></options></defaultWidget><group v="World Space"/></paraminput></paraminputs><primaryInput v="1500000002"/><graphOutputs><graphoutput><identifier v="output"/><uid v="1500066568"/><attributes><label v="Output"/></attributes></graphoutput></graphOutputs><compNodes><compNode><uid v="1500000003"/><GUILayout><gpos v="-1600 0 0"/></GUILayout><compOutputs><compOutput><uid v="1500000004"/><comptype v="1"/></compOutput></compOutputs><compImplementation><compInputBridge><entry v="1500000002"/><parameters></parameters></compInputBridge></compImplementation></compNode><compNode><uid v="1500000006"/><GUILayout><gpos v="-1600 600 0"/></GUILayout><compOutputs><compOutput><uid v="1500000007"/><comptype v="2"/></compOutput></compOutputs><compImplementation><compInputBridge><entry v="1500000005"/><parameters></parameters></compInputBridge></compImplementation></compNode><compNode><uid v="1500000009"/><GUILayout><gpos v="-1600 200 0"/></GUILayout><compOutputs><compOutput><uid v="1500000010"/><comptype v="1"/></compOutput></compOutputs><compImplementation><compInputBridge><entry v="1500000008"/><parameters><parameter><name v="format"/><relativeTo v="0"/><paramValue><constantValueInt1 v="3"/></paramValue></parameter></parameters></compInputBridge></compImplementation></compNode><compNode><uid v="1500000012"/><GUILayout><gpos v="-1600 400 0"/></GUILayout><compOutputs><compOutput><uid v="1500000013"/><comptype v="2"/></compOutput></compOutp