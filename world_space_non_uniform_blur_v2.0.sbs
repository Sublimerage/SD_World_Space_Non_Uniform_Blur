ltWidget><name v=""/><options/></defaultWidget></paraminput><paraminput><identifier v="mesh_uv_mask"/><uid v="1500066580"/><attributes><label v="Mesh UV Mask"/></attributes><isConnectable v="1"/><type v="2"/><defaultValue><constantValueFloat1 v="0"/></defaultValue><defaultWidget><name v=""/><options/></defaultWidget></paraminput><paraminput><identifier v="samples"/><uid v="1500066583"/><attributes><label v="Samples"/><description v="Number of blur passes. More passes fill the bokeh shape more smoothly (and cost more)."/></attributes><type v="16"/><defaultValue><constantValueInt1 v="4"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="4"/></option><option><name v="max"/><value v="16"/></option><option><name v="min"/><value v="1"/></option><option><name v="step"/><value v="1"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="intensity"/><uid v="1500066584"/><attributes><label v="Intensity"/><description v="Blur radius, in the same units as the 2D Non-Uniform Blur (1 = 1/256 of the UV space), at the mesh's average texel density. Doesn't depend on how far apart the pieces are."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="10"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="10"/></option><option><name v="max"/><value v="50"/></option><option><name v="min"/><value v="0"/></option><option><name v="step"/><value v="0.01"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="anisotropy"/><uid v="1500066585"/><attributes><label v="Anisotropy"/><description v="Squashes the blur shape across the Angle direction (1 = a line)."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="0"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="0"/></option><option><name v="max"/><value v="1"/></option><option><name v="min"/><value v="0"/></option><option><name v="step"/><value v="0.01"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="blades"/><uid v="1500066586"/><attributes><label v="Blades"/><description v="Number of sides of the bokeh shape."/></attributes><type v="16"/><defaultValue><constantValueInt1 v="5"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="5"/></option><option><name v="max"/><value v="9"/></option><option><name v="min"/><value v="1"/></option><option><name v="step"/><value v="1"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="angle"/><uid v="1500066587"/><attributes><label v="Angle"/><description v="Rotation of the blur shape around the surface normal, measured from the Reference Axis."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="0"/></defaultValue><defaultWidget><name v="angle"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="0"/></option><option><name v="max"/><value v="1"/></option><option><name v="min"/><value v="0"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="use_blur_map"/><uid v="1500066588"/><attributes><label v="Use Blur Map"/><description v="Scale the blur per texel (off = uniform blur)."/></attributes><type v="4"/><defaultValue><constantValueBool v="1"/></defaultValue><defaultWidget><name v="buttons"/><options><option><name v="default"/><value v="1"/></option></options></defaultWidget><group v="Blur"/></paraminput><paraminput><identifier v="blur_map_from_input"/><uid v="1500066589"/><attributes><label v="Use Input As Blur Map"/><description v="Use the luminance of the Input itself as the blur map, so no extra texture is needed."/></attributes><type v="4"/><defaultValue><constantValueBool v="1"/></defaultValue><defaultWidget><name v="buttons"/><options><option><name v="default"/><value v="1"/></option></options></defaultWidget><group v="Blur"/><visibleIf v="input[&quot;use_blur_map&quot;]"/></paraminput><paraminput><identifier v="invert_blur_map"/><uid v="1500066590"/><attributes><label v="Invert Blur Map"/><description v="Blur the dark areas instead of the bright ones."/></attributes><type v="4"/><defaultValue><constantValueBool v="0"/></defaultValue><defaultWidget><name v="buttons"/><options><option><name v="default"/><value v="0"/></option></options></defaultWidget><group v="Blur"/><visibleIf v="input[&quot;use_blur_map&quot;]"/></paraminput><paraminput><identifier v="softness"/><uid v="1500066591"/><attributes><label v="Softness"/><description v="Blurs each tap of the bokeh. Higher values are smoother and wrap better around hard edges and curved areas; 0 keeps the sharpest bokeh shape."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="0.25"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="0.25"/></option><option><name v="max"/><value v="1"/></option><option><name v="min"/><value v="0"/></option><option><name v="step"/><value v="0.01"/></option></options></defaultWidget><group v="World Space"/></paraminput><paraminput><identifier v="quality"/><uid v="1500066592"/><attributes><label v="Quality"/><description v="Voxel budget, shared by all pieces (1 = 48^3, 2 = 64^3, 3 = 96^3, 4 = 128^3 voxels). Higher keeps finer detail at low Intensity and is slower."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="4"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="4"/></option><option><name v="max"/><value v="4"/></option><option><name v="min"/><value v="1"/></option><option><name v="step"/><value v="1"/></option></options></defaultWidget><group v="World Space"/></paraminput><paraminput><identifier v="axis_x"/><uid v="1500066593"/><attributes><label v="Reference Axis X"/><description v="Object-space direction that Angle 0 points to (projected on the surface)."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="0.0"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="0.0"/></option><option><name v="max"/><value v="1"/></option><option><name v="min"/><value v="-1"/></option><option><name v="step"/><value v="0.05"/></option></options></defaultWidget><group v="World Space"/></paraminput><paraminput><identifier v="axis_y"/><uid v="1500066594"/><attributes><label v="Reference Axis Y"/><description v="Object-space direction that Angle 0 points to (projected on the surface)."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="1.0"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="1.0"/></option><option><name v="max"/><value v="1"/></option><option><name v="min"/><value v="-1"/></option><option><name v="step"/><value v="0.05"/></option></options></defaultWidget><group v="World Space"/></paraminput><paraminput><identifier v="axis_z"/><uid v="1500066595"/><attributes><label v="Reference Axis Z"/><description v="Object-space direction that Angle 0 points to (projected on the surface)."/></attributes><type v="256"/><defaultValue><constantValueFloat1 v="0.0"/></defaultValue><defaultWidget><name v="slider"/><options><option><name v="clamp"/><value v="1"/></option><option><name v="default"/><value v="0.0"/></option><option><name v="max"/><value v="1"/></option><option><name v="min"/><value v="-1"/></option><option><name v="step"/><value v="0.05"/></option></options></defaultWidget><group v="World Space"/></paraminput><paraminput><identifier v="dither"/><